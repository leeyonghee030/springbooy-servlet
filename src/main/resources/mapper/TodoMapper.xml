<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.study.spingbootservlet.mapper.TodoMapper">

    <select id="findAll" resultType="com.study.spingbootservlet.entity.Todo">
        SELECT id, userId, title, completed
        FROM todos
    </select>
    
    <select id="findById" resultType="com.study.spingbootservlet.entity.Todo">
        SELECT id, userId, title, completed
        FROM todos
        WHERE id = #{id}
    </select>

    <select id="findByUserId" resultType="com.study.spingbootservlet.entity.Todo">
        SELECT id, userId, title, completed
        FROM todos
        WHERE userId = #{userId}
    </select>
    
    <insert id="save" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO todos(userId,title,completed)
        VALUES (#{userId}, #{title}, #{completed})
    </insert>
    
    <update id="update">
        UPDATE todos
        SET title= #{title}, completed = #{completed}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM todos
        WHERE id = #{id}
    </delete>
</mapper>
